# ==============================================================================
# Appify Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase & Database Configuration (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# احصل على هذه الروابط من لوحة تحكم Supabase:
# Project Settings -> Database -> Connection string

# رابط الاتصال عبر مجمع الاتصالات (Connection Pooling / PgBouncer - Port 6543)
# يستخدم لتشغيل التطبيق والطلبات السريعة في بيئة Serverless على Vercel
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# رابط الاتصال المباشر (Direct Connection - Port 5432)
# يستخدم من قبل Prisma لتطبيق الترحيلات (Migrations / prisma db push)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# مفاتيح Supabase العامة (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 2. NextAuth Configuration (إن أردت تفعيل المصادقة)
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# قم بتوليد مفتاح سري عشوائي عبر: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# ------------------------------------------------------------------------------
# 3. APK Builder Service (اختياري - للإنتاج على Vercel)
# ------------------------------------------------------------------------------
# نظراً لأن دوال Vercel لا تدعم تشغيل حزمة Android SDK محلياً لكبر حجمها،
# يمكنك تحديد رابط خادم خارجي مخصص للبناء أو تركها فارغة للاعتماد على تحميل حزمة المشروع ZIP
# APK_BUILDER_SERVICE_URL="https://your-dedicated-builder-worker.com/api/build"
